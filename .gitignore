# =============================================================================
#  .gitignore —— ESP-Mosaico FluidBox
#
#  参考 xingxingRealzyx/esp-mmd/.gitignore，另外补上 ESP-IDF 组件管理器在
#  安装依赖时会重新生成的那几样东西（managed_components/、dependencies.lock）
#  以及本工程的 sdkconfig。
# =============================================================================

# ---- ESP-IDF 构建产物 -------------------------------------------------------
build/
sdkconfig
sdkconfig.old

# ---- ESP-IDF 组件管理器（可由 idf_component.yml 重新拉取） ------------------
managed_components/
dependencies.lock

# ---- Python 虚拟环境（PC 侧 bridge 的依赖，可由 requirements 重建）----------
.venv/
venv/

__pycache__/
*.pyc
*.pyo

# ---- IDE / 编辑器 -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ---------------------------------------------------------------
.DS_Store
Thumbs.db
